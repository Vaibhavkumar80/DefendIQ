# --- Required ---
MONGODB_URI=mongodb://127.0.0.1:27017/defendiq
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# --- Server ---
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
# Set to 1 when running behind a reverse proxy (nginx, Render, etc.)
TRUST_PROXY=0

# --- Optional: Google sign-in (free). Create an OAuth Web client at console.cloud.google.com ---
GOOGLE_CLIENT_ID=

# --- Optional: threat feeds (comma separated plain-text URL lists). Empty value disables feeds. ---
# Check each feed's terms of use before commercial use.
THREAT_FEED_URLS=https://openphish.com/feed.txt,https://urlhaus.abuse.ch/downloads/text_online/

# --- Optional: local AI explanations via Ollama (https://ollama.com). Leave OLLAMA_MODEL empty to disable. ---
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# --- Optional: SMTP for password-reset emails. Without it, reset email delivery is unavailable. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DefendIQ <no-reply@localhost>
